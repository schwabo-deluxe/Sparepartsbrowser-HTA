<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Ersatzteildatenbank</title>
<hta:application
    id="EtdbApp"
    applicationname="Ersatzteildatenbank"
    border="thin"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    showintaskbar="yes"
    scroll="no"
    singleinstance="yes"
    windowstate="maximize"
/>
<style type="text/css">
  * { box-sizing: border-box; }
  html, body {
    height: 100%; margin: 0; padding: 0;
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    font-size: 13px; color: #1f2933; background: #eef1f5;
  }
  #app { display: flex; flex-direction: column; height: 100%; }

  header {
    background: #1f3a5f; color: #fff; padding: 10px 16px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
  }
  header h1 { font-size: 18px; margin: 0 16px 0 0; font-weight: 600; white-space: nowrap; }
  header .grow { flex: 1 1 auto; }

  .toolbar {
    background: #f7f9fc; border-bottom: 1px solid #d5dae2;
    padding: 8px 16px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  }
  .toolbar label { font-size: 12px; color: #52606d; }

  input[type=text], input[type=number], select, textarea {
    font-family: inherit; font-size: 13px; padding: 5px 7px;
    border: 1px solid #b8c1cc; border-radius: 4px; background: #fff; color: #1f2933;
  }
  input[type=text]:focus, input[type=number]:focus, select:focus, textarea:focus {
    outline: none; border-color: #2f6fbf; box-shadow: 0 0 0 2px rgba(47,111,191,.2);
  }
  #q { min-width: 300px; }

  button {
    font-family: inherit; font-size: 13px; padding: 6px 12px; cursor: pointer;
    border: 1px solid #b8c1cc; border-radius: 4px; background: #fff; color: #1f2933;
  }
  button:hover { background: #eef2f7; }
  button.primary { background: #2f6fbf; border-color: #2f6fbf; color: #fff; }
  button.primary:hover { background: #2860a6; }
  button.small { padding: 3px 8px; font-size: 12px; }
  button.danger { color: #a12; border-color: #e2b3b8; }
  button.danger:hover { background: #fbeaec; }

  #content { flex: 1 1 auto; overflow: auto; padding: 0 16px 16px; }

  table { border-collapse: collapse; width: 100%; background: #fff; }
  thead th {
    position: relative; top: 0; z-index: 5;
    background: #e3e9f1; color: #34435a; text-align: left;
    padding: 8px 8px; border-bottom: 2px solid #c3ccd8; font-weight: 600;
    cursor: pointer; white-space: nowrap;
  }
  thead th .arrow { color: #7a8794; font-size: 10px; }
  tbody td { padding: 6px 8px; border-bottom: 1px solid #e6eaf0; vertical-align: top; word-wrap: break-word; overflow-wrap: break-word; word-break: break-word; }
  .resizer {
    position: absolute; top: 0; right: 0; width: 6px; height: 100%;
    cursor: col-resize; z-index: 6; background: transparent;
  }
  .resizer:hover { background: #a9c4e6; }
  .platzwrap { margin-top: 3px; }
  .platztog { color: #2f6fbf; cursor: pointer; font-size: 11px; font-weight: 600; }
  .platztog:hover { text-decoration: underline; }
  .platzlist { display: none; margin-top: 2px; color: #52606d; font-size: 11px; line-height: 1.5; }
  tbody tr:hover { background: #f3f7fd; }
  tbody tr.warn { background: #fff4e5; }
  tbody tr.warn:hover { background: #ffedd4; }
  tbody tr.ordered td.status { color: #1f6feb; font-weight: 600; }
  tbody tr.hidden { opacity: .55; font-style: italic; }
  tbody tr.hidden:hover { opacity: .8; }

  .badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .badge.ok { background: #e3f4e8; color: #1a7f37; }
  .badge.low { background: #fde4d4; color: #b64a10; }
  .badge.zero { background: #fbd3d6; color: #a1121f; }
  .badge.ordered { background: #dce8fd; color: #1f4fb0; }

  .qty { font-weight: 600; font-size: 14px; }
  .muted { color: #7a8794; }
  .kw { color: #52606d; font-size: 12px; }
  .sub { color: #90a0b0; font-size: 11px; }
  a.link { color: #2f6fbf; cursor: pointer; text-decoration: underline; }

  .actions { white-space: nowrap; }
  .actions button { margin-right: 3px; }

  footer { background: #f7f9fc; border-top: 1px solid #d5dae2; padding: 6px 16px; font-size: 12px; color: #52606d; }

  #overlay {
    display: none; position: fixed; left: 0; top: 0; width: 100%; height: 100%;
    background: rgba(20,30,45,.45); z-index: 100;
  }
  #modal {
    background: #fff; width: 720px; max-width: 94%; margin: 30px auto; border-radius: 8px;
    box-shadow: 0 12px 40px rgba(0,0,0,.3); overflow: hidden;
  }
  #modal .mhead { background: #1f3a5f; color: #fff; padding: 12px 18px; font-size: 16px; font-weight: 600; }
  #modal .mbody { padding: 18px; max-height: 74vh; overflow: auto; }
  #modal .mfoot { padding: 12px 18px; border-top: 1px solid #e0e5ec; text-align: right; }
  .field { margin-bottom: 12px; }
  .field label { display: block; font-size: 12px; color: #52606d; margin-bottom: 3px; }
  .field input, .field select, .field textarea { width: 100%; }
  .row2 { display: flex; gap: 12px; }
  .row2 .field, .row3 .field { flex: 1; }
  .row3 { display: flex; gap: 12px; }
  .hint { font-size: 11px; color: #90a0b0; margin-top: 2px; }
</style>

<script language="JScript">
// ===================== Ersatzteildatenbank (HTA) =====================
// Feldschema an Excel "Ersatzteilmatrix" angelehnt.
var DATA_FILE = "ersatzteile.json";
var parts = [];
var sortKey = "position";
var sortAsc = true;
var editId = null;

// ---- Zugriffsschutz -------------------------------------------------
// Passwort für Bearbeiten / Löschen / Neu anlegen / Import.
// >>> HIER DAS PASSWORT ANPASSEN <<<
var ADMIN_PW = "1234";
var authed = false;
function requireAuth() {
  if (authed) return true;
  var pw = prompt("Passwort für Bearbeiten / Löschen / Anlegen:", "");
  if (pw == null) return false;
  if (pw == ADMIN_PW) { authed = true; updateAuthUi(); return true; }
  alert("Falsches Passwort.");
  return false;
}
function toggleLock() {
  if (authed) { authed = false; updateAuthUi(); }
  else { requireAuth(); }
}
function updateAuthUi() {
  var b = byId("authBtn");
  if (b) b.innerHTML = authed ? "&#128275; Entsperrt" : "&#128274; Gesperrt";
}

// Interne Felder <-> Excel-Spaltenüberschriften (für CSV-Import/-Export)
// Reihenfolge = Reihenfolge in der Excel
var COLMAP = [
  { key:"position",      xls:"Position" },
  { key:"menge",         xls:"Menge" },
  { key:"artikelnummer", xls:"Artikelnummer" },
  { key:"erwArtNr",      xls:"Erweiterte Art.Nr" },
  { key:"nachfolger",    xls:"Nachfolger" },
  { key:"bezeichnung",   xls:"Artikelbezeichnung" },
  { key:"bin",           xls:"Bin" },
  { key:"posTyp",        xls:"Position/Typ" },
  { key:"istMenge",      xls:"IstMenge" },
  { key:"minMenge",      xls:"MinMenge" },
  { key:"unterMin",      xls:"UnterMinMeng" },
  { key:"bestellt",      xls:"Bestellt" },
  { key:"bauteilgruppe", xls:"Bauteilgruppe" },
  { key:"hersteller",    xls:"Hersteller" },
  { key:"zuordnung",     xls:"Zuordnung" },
  { key:"platz",         xls:"Platz" },
  { key:"schlagworte",   xls:"Schlagworte" },
  { key:"bemerkung",     xls:"Bemerkung" },
  { key:"ausgeblendet",  xls:"Ausgeblendet" },
  { key:"geaendert",     xls:"Geaendert" }
];

// ---- Spaltendefinition (mit speicherbaren Breiten) ----
var COLDEF = [
  { k:"position",      t:"Pos.",          s:"position",      w:55 },
  { k:"artikelnummer", t:"Artikel-Nr.",   s:"artikelnummer", w:150 },
  { k:"erwArtNr",      t:"Erw. Art.Nr",   s:"erwArtNr",      w:130 },
  { k:"bezeichnung",   t:"Bezeichnung",   s:"bezeichnung",   w:300 },
  { k:"bauteilgruppe", t:"Bauteilgruppe", s:"bauteilgruppe", w:120 },
  { k:"bin",           t:"Bin",           s:"bin",           w:90 },
  { k:"istMenge",      t:"IstMenge",      s:"istMenge",      w:80, r:true },
  { k:"minMenge",      t:"MinMenge",      s:"minMenge",      w:80, r:true },
  { k:"status",        t:"Status",        s:"bestellt",      w:80 },
  { k:"nachfolger",    t:"Nachfolger",    s:"nachfolger",    w:120 },
  { k:"actions",       t:"Aktionen",      s:null,            w:290 }
];
function viewPath() { return scriptDir() + "\\ansicht.json"; }
function loadWidths() {
  try {
    var raw = readFileUtf8(viewPath());
    if (!trim(raw).length) return;
    var arr = eval("(" + raw + ")");
    for (var i=0;i<COLDEF.length && i<arr.length;i++) if (arr[i]>20) COLDEF[i].w = arr[i];
  } catch (e) {}
}
function saveWidths() {
  try {
    var a = []; for (var i=0;i<COLDEF.length;i++) a.push(COLDEF[i].w);
    writeFileUtf8(viewPath(), "[" + a.join(",") + "]");
  } catch (e) {}
}

// ---- Persistenz via ADODB.Stream (UTF-8) ----
function scriptDir() {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var path = unescape(location.pathname);
  if (path.charAt(0) == "/") path = path.substring(1);
  path = path.replace(/\//g, "\\");
  return fso.GetParentFolderName(path);
}
function dataPath() { return scriptDir() + "\\" + DATA_FILE; }
function logPath() { return scriptDir() + "\\buchungen_log.csv"; }

function readFileUtf8(p) {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  if (!fso.FileExists(p)) return "";
  var s = new ActiveXObject("ADODB.Stream");
  s.Type = 2; s.Charset = "utf-8"; s.Open();
  s.LoadFromFile(p);
  var txt = s.ReadText(-1);
  s.Close();
  if (txt.length && txt.charCodeAt(0) == 0xFEFF) txt = txt.substring(1);
  return txt;
}
function writeFileUtf8(p, txt) {
  var s = new ActiveXObject("ADODB.Stream");
  s.Type = 2; s.Charset = "utf-8"; s.Open();
  s.WriteText(txt);
  s.Position = 0; s.Type = 1; s.Position = 3; // BOM überspringen
  var noBom = new ActiveXObject("ADODB.Stream");
  noBom.Type = 1; noBom.Open();
  s.CopyTo(noBom);
  s.Flush(); s.Close();
  noBom.SaveToFile(p, 2);
  noBom.Close();
}

// ---- JSON ----
function jsonParse(str) {
  if (!str || !trim(str).length) return [];
  try { return eval("(" + str + ")"); } catch (e) { alert("Datendatei konnte nicht gelesen werden:\n" + e.message); return []; }
}
function esc(s) {
  s = "" + s;
  s = s.replace(/\\/g, "\\\\").replace(/"/g, "\\\"");
  s = s.replace(/\r/g, "\\r").replace(/\n/g, "\\n").replace(/\t/g, "\\t");
  return s;
}
function jsonStringify(arr) {
  var out = ["["];
  for (var i = 0; i < arr.length; i++) {
    var p = arr[i]; var f = [];
    for (var k in p) {
      if (!p.hasOwnProperty(k)) continue;
      var v = p[k];
      if (typeof v == "number") f.push("\"" + k + "\":" + v);
      else if (typeof v == "boolean") f.push("\"" + k + "\":" + (v ? "true" : "false"));
      else f.push("\"" + k + "\":\"" + esc(v) + "\"");
    }
    out.push((i ? "," : "") + "\n  {" + f.join(",") + "}");
  }
  out.push("\n]");
  return out.join("");
}

// ---- Utils ----
function trim(s) {
  if (s == null) return "";
  s = ("" + s).replace(/^\s+|\s+$/g, "");
  if (s == "undefined" || s == "null") return "";
  return s;
}
function byId(id) { return document.getElementById(id); }
function num(v) { var n = parseInt(("" + v).replace(/[^\d\-]/g, ""), 10); return isNaN(n) ? 0 : n; }
function nowStamp() {
  var d = new Date();
  function p(n){ return (n<10?"0":"")+n; }
  return d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate())+" "+p(d.getHours())+":"+p(d.getMinutes());
}
function nowStampFull() {
  var d = new Date();
  function p(n){ return (n<10?"0":"")+n; }
  return d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate())+" "+p(d.getHours())+":"+p(d.getMinutes())+":"+p(d.getSeconds());
}
function winUser() { try { return new ActiveXObject("WScript.Network").UserName; } catch (e) { return ""; } }
function newId() { return "T" + (new Date()).getTime() + Math.floor(Math.random()*1000); }
function htmlEnc(s) {
  s = "" + (s == null ? "" : s);
  return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function truthy(v) {
  v = trim(v).toLowerCase();
  return (v=="1"||v=="ja"||v=="x"||v=="true"||v=="wahr"||v=="y"||v=="yes"||v=="bestellt");
}

// Normalisiert ein Teil-Objekt
function normalize(p) {
  return {
    id:            p.id || newId(),
    position:      trim(p.position),
    menge:         num(p.menge),
    artikelnummer: trim(p.artikelnummer),
    erwArtNr:      trim(p.erwArtNr),
    nachfolger:    trim(p.nachfolger),
    bezeichnung:   trim(p.bezeichnung),
    bin:           trim(p.bin),
    posTyp:        trim(p.posTyp),
    istMenge:      num(p.istMenge),
    minMenge:      num(p.minMenge),
    bestellt:      (typeof p.bestellt == "boolean") ? p.bestellt : truthy(p.bestellt),
    bauteilgruppe: trim(p.bauteilgruppe),
    hersteller:    trim(p.hersteller),
    zuordnung:     trim(p.zuordnung),
    platz:         trim(p.platz),
    schlagworte:   trim(p.schlagworte),
    bemerkung:     trim(p.bemerkung),
    ausgeblendet:  (typeof p.ausgeblendet == "boolean") ? p.ausgeblendet : truthy(p.ausgeblendet),
    geaendert:     trim(p.geaendert)
  };
}

// ---- Laden / Speichern ----
function loadData() {
  var raw = readFileUtf8(dataPath());
  var arr = jsonParse(raw);
  parts = [];
  for (var i = 0; i < arr.length; i++) parts.push(normalize(arr[i]));
}
function saveData() {
  try { writeFileUtf8(dataPath(), jsonStringify(parts)); }
  catch (e) { alert("Speichern fehlgeschlagen:\n" + e.message + "\n\nSpeicherort: " + dataPath()); }
}

// ---- Audit-Trail / Buchungsprotokoll ----
var LOG_COLS = ["Zeitpunkt","Aktion","Artikelnummer","Bezeichnung","Menge","Bestand_vorher","Bestand_nachher","Benutzer"];
function appendLog(aktion, p, menge, vorher, nachher) {
  var sep = ";";
  try {
    var existing = readFileUtf8(logPath());
    if (!trim(existing).length) existing = "﻿" + LOG_COLS.join(sep) + "\r\n";
    else if (existing.charAt(existing.length-1) != "\n") existing += "\r\n";
    var line = [ nowStampFull(), aktion, csvQ(p.artikelnummer, sep), csvQ(p.bezeichnung, sep),
                 menge, vorher, nachher, csvQ(winUser(), sep) ].join(sep);
    writeFileUtf8(logPath(), existing + line + "\r\n");
  } catch (e) {
    alert("Protokoll konnte nicht geschrieben werden:\n" + e.message);
  }
}

// ---- Bestandslogik ----
function isWarn(p) { return p.istMenge < p.minMenge; }
function stockClass(p) {
  if (p.istMenge <= 0 && p.minMenge > 0) return "zero";
  if (p.istMenge < p.minMenge) return "low";
  return "ok";
}

// ---- Filtern / Sortieren / Rendern ----
function currentFiltered() {
  var q = trim(byId("q").value).toLowerCase();
  var terms = q.length ? q.split(/\s+/) : [];
  var stat = byId("fStatus").value;
  var onlyWarn = byId("fWarn").checked;
  var showHidden = byId("fHidden").checked;

  var res = [];
  for (var i = 0; i < parts.length; i++) {
    var p = parts[i];
    if (p.ausgeblendet && !showHidden) continue;
    if (stat == "Bestellt" && !p.bestellt) continue;
    if (stat == "Vorhanden" && p.bestellt) continue;
    if (onlyWarn && !isWarn(p)) continue;
    if (terms.length) {
      var hay = (p.artikelnummer+" "+p.erwArtNr+" "+p.bezeichnung+" "+p.schlagworte+" "+
                 p.bauteilgruppe+" "+p.bin+" "+p.hersteller+" "+p.zuordnung+" "+p.platz+" "+p.nachfolger+" "+p.posTyp).toLowerCase();
      var ok = true;
      for (var t = 0; t < terms.length; t++) { if (hay.indexOf(terms[t]) < 0) { ok = false; break; } }
      if (!ok) continue;
    }
    res.push(p);
  }
  res.sort(function(a, b) {
    var va = a[sortKey], vb = b[sortKey];
    if (typeof va == "boolean") va = va?1:0;
    if (typeof vb == "boolean") vb = vb?1:0;
    if (typeof va == "number" && typeof vb == "number") return sortAsc ? va - vb : vb - va;
    va = ("" + va).toLowerCase(); vb = ("" + vb).toLowerCase();
    if (va < vb) return sortAsc ? -1 : 1;
    if (va > vb) return sortAsc ? 1 : -1;
    return 0;
  });
  return res;
}

function statusBadge(p) {
  if (p.bestellt) return '<span class="badge ordered">Bestellt</span>';
  var c = stockClass(p);
  if (c == "zero") return '<span class="badge zero">Leer</span>';
  if (c == "low")  return '<span class="badge low">Niedrig</span>';
  return '<span class="badge ok">OK</span>';
}

function findByArtikelnummer(an) {
  an = trim(an).toLowerCase();
  if (!an.length) return null;
  for (var i = 0; i < parts.length; i++) {
    if (parts[i].artikelnummer.toLowerCase() == an) return parts[i];
    if (parts[i].erwArtNr.toLowerCase() == an) return parts[i];
  }
  return null;
}

function render() {
  var list = currentFiltered();
  var warnCount = 0;
  for (var i = 0; i < parts.length; i++) if (isWarn(parts[i])) warnCount++;

  function arrow(k) { return sortKey == k ? '<span class="arrow">' + (sortAsc ? "&#9650;" : "&#9660;") + '</span>' : ''; }

  var total = 0; for (var ci=0; ci<COLDEF.length; ci++) total += COLDEF[ci].w;

  var h = [];
  h.push('<table style="table-layout:fixed;width:'+total+'px">');
  h.push('<colgroup>');
  for (var ci2=0; ci2<COLDEF.length; ci2++) h.push('<col id="col_'+ci2+'" style="width:'+COLDEF[ci2].w+'px" />');
  h.push('</colgroup>');
  h.push('<thead><tr>');
  for (var ci3=0; ci3<COLDEF.length; ci3++) {
    var cd = COLDEF[ci3];
    var al = cd.r ? ' style="text-align:right"' : '';
    var oc = cd.s ? ' onclick="setSort(\''+cd.s+'\')"' : '';
    var ar = cd.s ? (' '+arrow(cd.s)) : '';
    h.push('<th'+al+oc+'>'+cd.t+ar+
           '<span class="resizer" onmousedown="startResize(event,'+ci3+')" onclick="stopClick(event)">&nbsp;</span></th>');
  }
  h.push('</tr></thead><tbody>');

  if (!list.length) h.push('<tr><td colspan="'+COLDEF.length+'" class="muted" style="padding:20px;text-align:center">Keine Treffer.</td></tr>');

  for (var j = 0; j < list.length; j++) {
    var p = list[j];
    var rc = [];
    if (isWarn(p)) rc.push("warn");
    if (p.bestellt) rc.push("ordered");
    if (p.ausgeblendet) rc.push("hidden");

    var sub = [];
    if (trim(p.hersteller).length) sub.push(htmlEnc(p.hersteller));
    if (trim(p.zuordnung).length) sub.push(htmlEnc(p.zuordnung));
    var subHtml = sub.length ? '<div class="sub">'+sub.join(" &middot; ")+'</div>' : '';
    var kw = trim(p.schlagworte).length ? '<div class="kw">'+htmlEnc(p.schlagworte)+'</div>' : '';

    var platzHtml = "";
    if (trim(p.platz).length) {
      var pl = p.platz.split(/;\s*/);
      var cnt = 0; for (var pi=0; pi<pl.length; pi++) if (trim(pl[pi]).length) cnt++;
      platzHtml = '<div class="platzwrap">'
        + '<span class="platztog" id="ptog_'+p.id+'" onclick="togglePlatz(\''+p.id+'\')">&#43; Platz ('+cnt+')</span>'
        + '<div class="platzlist" id="plist_'+p.id+'">'+htmlEnc(p.platz)+'</div>'
        + '</div>';
    }

    var nf = "";
    if (trim(p.nachfolger).length) {
      var target = findByArtikelnummer(p.nachfolger);
      if (target) nf = '<a class="link" onclick="jumpTo(\''+target.id+'\')">'+htmlEnc(p.nachfolger)+'</a>';
      else nf = htmlEnc(p.nachfolger) + ' <span class="muted">(n. angelegt)</span>';
    }

    h.push('<tr class="'+rc.join(" ")+'" id="row_'+p.id+'">');
    h.push('<td>'+htmlEnc(p.position)+'</td>');
    h.push('<td><strong>'+htmlEnc(p.artikelnummer)+'</strong>'+subHtml+platzHtml+'</td>');
    h.push('<td>'+htmlEnc(p.erwArtNr)+'</td>');
    h.push('<td>'+htmlEnc(p.bezeichnung)+kw+'</td>');
    h.push('<td>'+htmlEnc(p.bauteilgruppe)+'</td>');
    h.push('<td>'+htmlEnc(p.bin)+'</td>');
    h.push('<td style="text-align:right"><span class="qty">'+p.istMenge+'</span></td>');
    h.push('<td style="text-align:right">'+p.minMenge+'</td>');
    h.push('<td class="status">'+statusBadge(p)+'</td>');
    h.push('<td>'+nf+'</td>');
    h.push('<td class="actions">');
    h.push('<button class="small" onclick="einbuchen(\''+p.id+'\')" title="Einbuchen">+ Ein</button>');
    h.push('<button class="small" onclick="ausbuchen(\''+p.id+'\')" title="Ausbuchen">- Aus</button>');
    h.push('<button class="small" onclick="toggleBestellt(\''+p.id+'\')" title="Bestellt umschalten">'+(p.bestellt?"&#10003; Best.":"Best.")+'</button>');
    h.push('<button class="small" onclick="openEdit(\''+p.id+'\')">Bearb.</button>');
    h.push('<button class="small" onclick="toggleHidden(\''+p.id+'\')" title="Ausblenden / Einblenden">'+(p.ausgeblendet?"Einbl.":"Ausbl.")+'</button>');
    h.push('<button class="small danger" onclick="delPart(\''+p.id+'\')">L&ouml;schen</button>');
    h.push('</td></tr>');
  }
  h.push('</tbody></table>');
  byId("content").innerHTML = h.join("");

  byId("stat").innerHTML = list.length + " von " + parts.length + " Teilen angezeigt &middot; " +
    '<span style="color:#b64a10;font-weight:600">' + warnCount + " unter Grenzwert</span> &middot; Datei: " + htmlEnc(dataPath());
  stickHeader();
}

function setSort(k) { if (sortKey == k) sortAsc = !sortAsc; else { sortKey = k; sortAsc = true; } render(); }
function jumpTo(id) {
  byId("q").value = ""; byId("fStatus").value = ""; byId("fWarn").checked = false;
  render();
  var row = byId("row_" + id);
  if (row) { row.scrollIntoView(); row.style.background = "#d7ecff"; }
}

// ---- Aktionen ----
function getPart(id) { for (var i=0;i<parts.length;i++) if (parts[i].id==id) return parts[i]; return null; }

function einbuchen(id) {
  var p = getPart(id); if (!p) return;
  var v = prompt("Einbuchen – Menge für:\n" + p.artikelnummer + " (" + p.bezeichnung + ")\nAktuelle IstMenge: " + p.istMenge, "1");
  if (v == null) return;
  var n = num(v); if (n <= 0) { alert("Bitte positive Menge eingeben."); return; }
  var vorher = p.istMenge;
  p.istMenge += n;
  if (p.bestellt && p.istMenge >= p.minMenge) p.bestellt = false; // Ware da -> nicht mehr bestellt
  p.geaendert = nowStamp();
  appendLog("Einbuchen", p, n, vorher, p.istMenge);
  saveData(); render();
}
function ausbuchen(id) {
  var p = getPart(id); if (!p) return;
  var v = prompt("Ausbuchen – Menge für:\n" + p.artikelnummer + " (" + p.bezeichnung + ")\nAktuelle IstMenge: " + p.istMenge, "1");
  if (v == null) return;
  var n = num(v); if (n <= 0) { alert("Bitte positive Menge eingeben."); return; }
  if (n > p.istMenge) { if (!confirm("Menge größer als Bestand. IstMenge auf 0 setzen?")) return; n = p.istMenge; }
  var vorher = p.istMenge;
  p.istMenge -= n;
  p.geaendert = nowStamp();
  appendLog("Ausbuchen", p, n, vorher, p.istMenge);
  saveData(); render();
  if (isWarn(p)) {
    var msg = "⚠ Warnung: IstMenge für " + p.artikelnummer + " (" + p.istMenge + ") ist unter dem Grenzwert (MinMenge " + p.minMenge + ").";
    if (trim(p.nachfolger).length) msg += "\nNachfolger: " + p.nachfolger;
    if (!p.bestellt) msg += "\n\nJetzt auf 'Bestellt' setzen?";
    if (!p.bestellt) { if (confirm(msg)) { p.bestellt = true; p.geaendert = nowStamp(); saveData(); render(); } }
    else alert(msg);
  }
}
function toggleBestellt(id) {
  var p = getPart(id); if (!p) return;
  p.bestellt = !p.bestellt; p.geaendert = nowStamp();
  saveData(); render();
}
function toggleHidden(id) {
  var p = getPart(id); if (!p) return;
  p.ausgeblendet = !p.ausgeblendet; p.geaendert = nowStamp();
  saveData(); render();
}
function delPart(id) {
  if (!requireAuth()) return;
  var p = getPart(id); if (!p) return;
  if (!confirm("Teil wirklich löschen?\n" + p.artikelnummer + " – " + p.bezeichnung)) return;
  for (var i=0;i<parts.length;i++) if (parts[i].id==id) { parts.splice(i,1); break; }
  saveData(); render();
}

// ---- Formular ----
function openNew() {
  if (!requireAuth()) return;
  editId = null;
  byId("mtitle").innerHTML = "Neues Teil anlegen";
  var f = ["position","menge","artikelnummer","erwArtNr","nachfolger","bezeichnung","bin","posTyp","istMenge","minMenge","bauteilgruppe","hersteller","zuordnung","platz","schlagworte","bemerkung"];
  for (var i=0;i<f.length;i++) setField("f_"+f[i], (f[i]=="menge"||f[i]=="istMenge"||f[i]=="minMenge")?"0":"");
  byId("f_bestellt").checked = false;
  byId("f_ausgeblendet").checked = false;
  showModal(true);
}
function openEdit(id) {
  if (!requireAuth()) return;
  var p = getPart(id); if (!p) return;
  editId = id;
  byId("mtitle").innerHTML = "Teil bearbeiten";
  setField("f_position",p.position); setField("f_menge",p.menge);
  setField("f_artikelnummer",p.artikelnummer); setField("f_erwArtNr",p.erwArtNr);
  setField("f_nachfolger",p.nachfolger); setField("f_bezeichnung",p.bezeichnung);
  setField("f_bin",p.bin); setField("f_posTyp",p.posTyp);
  setField("f_istMenge",p.istMenge); setField("f_minMenge",p.minMenge);
  setField("f_bauteilgruppe",p.bauteilgruppe); setField("f_hersteller",p.hersteller);
  setField("f_zuordnung",p.zuordnung); setField("f_platz",p.platz);
  setField("f_schlagworte",p.schlagworte); setField("f_bemerkung",p.bemerkung);
  byId("f_bestellt").checked = p.bestellt;
  byId("f_ausgeblendet").checked = p.ausgeblendet;
  showModal(true);
}
function setField(id,v){ byId(id).value = (v==null?"":v); }
function showModal(on){ byId("overlay").style.display = on ? "block" : "none"; if(on) byId("f_artikelnummer").focus(); }
function closeModal(){ showModal(false); }

function saveForm() {
  var an = trim(byId("f_artikelnummer").value);
  if (!an.length) { alert("Bitte Artikelnummer eingeben."); byId("f_artikelnummer").focus(); return; }
  var dup = findByArtikelnummer(an);
  if (dup && dup.id != editId) { if (!confirm("Artikelnummer existiert bereits. Trotzdem speichern?")) return; }

  var p = editId ? getPart(editId) : normalize({});
  p.position     = trim(byId("f_position").value);
  p.menge        = num(byId("f_menge").value);
  p.artikelnummer= an;
  p.erwArtNr     = trim(byId("f_erwArtNr").value);
  p.nachfolger   = trim(byId("f_nachfolger").value);
  p.bezeichnung  = trim(byId("f_bezeichnung").value);
  p.bin          = trim(byId("f_bin").value);
  p.posTyp       = trim(byId("f_posTyp").value);
  p.istMenge     = num(byId("f_istMenge").value);
  p.minMenge     = num(byId("f_minMenge").value);
  p.bestellt     = byId("f_bestellt").checked;
  p.ausgeblendet = byId("f_ausgeblendet").checked;
  p.bauteilgruppe= trim(byId("f_bauteilgruppe").value);
  p.hersteller   = trim(byId("f_hersteller").value);
  p.zuordnung    = trim(byId("f_zuordnung").value);
  p.platz        = trim(byId("f_platz").value);
  p.schlagworte  = trim(byId("f_schlagworte").value);
  p.bemerkung    = trim(byId("f_bemerkung").value);
  p.geaendert    = nowStamp();

  if (!editId) parts.push(p);
  saveData(); closeModal(); render();
}

// ---- CSV Export / Import (Excel-Spaltenüberschriften) ----
function keyToXls(key){ for (var i=0;i<COLMAP.length;i++) if (COLMAP[i].key==key) return COLMAP[i].xls; return key; }
function xlsToKey(h){
  h = trim(h).toLowerCase();
  for (var i=0;i<COLMAP.length;i++) if (COLMAP[i].xls.toLowerCase()==h) return COLMAP[i].key;
  // Toleranz für Varianten
  if (h=="art.nr"||h=="artnr"||h=="art-nr") return "artikelnummer";
  if (h=="erweiterte art.nr."||h=="erw. art.nr"||h=="erweiterte artikelnummer") return "erwArtNr";
  if (h=="bezeichnung") return "bezeichnung";
  return null;
}
function csvQ(v, sep){ v="" + (v==null?"":v); if (v.indexOf(sep)>=0 || v.indexOf('"')>=0 || v.indexOf("\n")>=0 || v.indexOf("\r")>=0) v='"'+v.replace(/"/g,'""')+'"'; return v; }

function exportCsv() {
  var sep = ";";
  var head = []; for (var i=0;i<COLMAP.length;i++) head.push(COLMAP[i].xls);
  var lines = [head.join(sep)];
  for (var r=0;r<parts.length;r++){
    var p=parts[r]; var row=[];
    for (var c=0;c<COLMAP.length;c++){
      var k=COLMAP[c].key, v;
      if (k=="unterMin") v = isWarn(p) ? "1" : "";
      else if (k=="bestellt") v = p.bestellt ? "1" : "";
      else if (k=="ausgeblendet") v = p.ausgeblendet ? "1" : "";
      else v = p[k];
      row.push(csvQ(v, sep));
    }
    lines.push(row.join(sep));
  }
  var path = scriptDir() + "\\ersatzteile_export.csv";
  try { writeFileUtf8(path, "﻿" + lines.join("\r\n")); alert("Export gespeichert:\n" + path); }
  catch(e){ alert("Export fehlgeschlagen:\n" + e.message); }
}

function importCsv() {
  if (!requireAuth()) return;
  var path = prompt("Pfad zur CSV-Datei (Semikolon-getrennt, Kopfzeile mit den Excel-Spaltennamen):", scriptDir()+"\\import.csv");
  if (path == null) return;
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  if (!fso.FileExists(path)) { alert("Datei nicht gefunden:\n"+path); return; }
  var raw = readFileUtf8(path);
  var rows = raw.split(/\r\n|\n|\r/);
  if (rows.length < 2) { alert("Keine Daten gefunden."); return; }
  var header = splitCsv(rows[0], ";");
  var keys = []; var known=0;
  for (var c=0;c<header.length;c++){ var k=xlsToKey(header[c]); keys.push(k); if (k) known++; }
  if (!known) { alert("Keine bekannten Spalten erkannt. Erwartete Kopfzeile z. B.:\n\nPosition;Menge;Artikelnummer;Erweiterte Art.Nr;Nachfolger;Artikelbezeichnung;Bin;Position/Typ;IstMenge;MinMenge;UnterMinMeng;Bestellt;Bauteilgruppe;Hersteller"); return; }

  var added=0, updated=0;
  for (var i=1;i<rows.length;i++){
    if (!trim(rows[i]).length) continue;
    var cells = splitCsv(rows[i], ";");
    var obj = {};
    for (var c2=0;c2<keys.length;c2++){ if (keys[c2]) obj[keys[c2]] = (cells[c2]!=null?cells[c2]:""); }
    if (!trim(obj.artikelnummer||"").length && !trim(obj.bezeichnung||"").length) continue;
    var np = normalize(obj);
    var ex = findByArtikelnummer(np.artikelnummer);
    if (ex && trim(np.artikelnummer).length) { np.id = ex.id; for (var k2 in np) if (np.hasOwnProperty(k2)) ex[k2]=np[k2]; updated++; }
    else { parts.push(np); added++; }
  }
  saveData(); render();
  alert("Import fertig.\nNeu: "+added+"\nAktualisiert: "+updated);
}
function splitCsv(line, sep) {
  var out=[], cur="", inQ=false;
  for (var i=0;i<line.length;i++){
    var ch=line.charAt(i);
    if (inQ){ if (ch=='"'){ if (line.charAt(i+1)=='"'){cur+='"';i++;} else inQ=false; } else cur+=ch; }
    else { if (ch=='"') inQ=true; else if (ch==sep){ out.push(cur); cur=""; } else cur+=ch; }
  }
  out.push(cur); return out;
}

function onSearchKey() { render(); }

// Platz-Liste ein-/ausklappen
function togglePlatz(id) {
  var d = byId("plist_"+id), a = byId("ptog_"+id);
  if (!d || !a) return;
  if (d.style.display == "block") { d.style.display = "none"; a.innerHTML = a.innerHTML.replace("− Platz", "+ Platz"); }
  else { d.style.display = "block"; a.innerHTML = a.innerHTML.replace("+ Platz", "− Platz"); }
}

// Spaltenbreite per Ziehen ändern
var rz = null;
function stopClick(e) { e = e || window.event; if (e.stopPropagation) e.stopPropagation(); e.cancelBubble = true; }
function startResize(e, idx) {
  e = e || window.event;
  if (e.stopPropagation) e.stopPropagation(); e.cancelBubble = true;
  if (e.preventDefault) e.preventDefault();
  rz = { idx: idx, startX: e.clientX, startW: COLDEF[idx].w };
  if (document.attachEvent) { document.attachEvent("onmousemove", onResizeMove); document.attachEvent("onmouseup", endResize); }
  else { document.onmousemove = onResizeMove; document.onmouseup = endResize; }
}
function onResizeMove(e) {
  if (!rz) return;
  e = e || window.event;
  var w = rz.startW + (e.clientX - rz.startX);
  if (w < 30) w = 30;
  COLDEF[rz.idx].w = w;
  var col = byId("col_"+rz.idx);
  if (col) col.style.width = w + "px";
  var total = 0; for (var i=0;i<COLDEF.length;i++) total += COLDEF[i].w;
  var tbl = byId("content").getElementsByTagName("table")[0];
  if (tbl) tbl.style.width = total + "px";
  return false;
}
function endResize() {
  if (!rz) return;
  rz = null;
  if (document.detachEvent) { document.detachEvent("onmousemove", onResizeMove); document.detachEvent("onmouseup", endResize); }
  else { document.onmousemove = null; document.onmouseup = null; }
  saveWidths();
}

// ---- Protokoll-Ansicht ----
function showLog() {
  var raw = readFileUtf8(logPath());
  var body = byId("logBody");
  var rows = trim(raw).length ? raw.split(/\r\n|\n|\r/) : [];
  // Kopfzeile entfernen
  if (rows.length && rows[0].indexOf("Zeitpunkt") == 0) rows.shift();
  var filt = trim(byId("logFilter").value).toLowerCase();

  var h = ['<table><thead><tr>'];
  for (var c=0;c<LOG_COLS.length;c++) h.push('<th>'+LOG_COLS[c].replace(/_/g," ")+'</th>');
  h.push('</tr></thead><tbody>');
  var shown = 0;
  for (var i = rows.length-1; i >= 0; i--) { // neueste zuerst
    if (!trim(rows[i]).length) continue;
    if (filt.length && rows[i].toLowerCase().indexOf(filt) < 0) continue;
    var cells = splitCsv(rows[i], ";");
    h.push('<tr>');
    for (var c2=0;c2<LOG_COLS.length;c2++) {
      var v = cells[c2]!=null?cells[c2]:"";
      var cls = (LOG_COLS[c2]=="Aktion" && v=="Ausbuchen") ? ' style="color:#b64a10;font-weight:600"' :
                (LOG_COLS[c2]=="Aktion" && v=="Einbuchen") ? ' style="color:#1a7f37;font-weight:600"' : '';
      h.push('<td'+cls+'>'+htmlEnc(v)+'</td>');
    }
    h.push('</tr>');
    shown++;
  }
  if (!shown) h.push('<tr><td colspan="'+LOG_COLS.length+'" class="muted" style="padding:20px;text-align:center">Keine Buchungen protokolliert.</td></tr>');
  h.push('</tbody></table>');
  body.innerHTML = h.join("");
  byId("logCount").innerHTML = shown + " Buchung(en) &middot; Datei: " + htmlEnc(logPath());
  byId("logOverlay").style.display = "block";
}
function closeLog() { byId("logOverlay").style.display = "none"; }
function refreshLog() { showLog(); }

// Kopfzeile anheften (IE-Engine kennt kein position:sticky -> per Scroll nachführen)
function stickHeader() {
  var c = byId("content");
  var ths = c.getElementsByTagName("th");
  var t = c.scrollTop;
  for (var i = 0; i < ths.length; i++) ths[i].style.top = t + "px";
}

function init() { loadWidths(); loadData(); render(); byId("q").focus(); }
</script>
</head>

<body onload="init()">
<div id="app">
  <header>
    <h1>&#128295; Ersatzteildatenbank</h1>
    <button class="primary" onclick="openNew()">+ Neues Teil</button>
    <button onclick="exportCsv()">CSV Export</button>
    <button onclick="importCsv()">CSV Import</button>
    <button onclick="showLog()">Protokoll</button>
    <span class="grow"></span>
    <button id="authBtn" onclick="toggleLock()">&#128274; Gesperrt</button>
  </header>

  <div class="toolbar">
    <label>Suche:</label>
    <input type="text" id="q" placeholder="Artikel-Nr., Schlagwort, Bezeichnung, Bauteilgruppe, Bin, Hersteller ..." onkeyup="onSearchKey()" />
    <label>Status:</label>
    <select id="fStatus" onchange="render()">
      <option value="">Alle</option>
      <option value="Vorhanden">Nicht bestellt</option>
      <option value="Bestellt">Bestellt</option>
    </select>
    <label><input type="checkbox" id="fWarn" onclick="render()" /> nur Warnungen (unter MinMenge)</label>
    <label><input type="checkbox" id="fHidden" onclick="render()" /> ausgeblendete anzeigen</label>
    <button onclick="byId('q').value='';byId('fStatus').value='';byId('fWarn').checked=false;byId('fHidden').checked=false;render();byId('q').focus();">Zur&uuml;cksetzen</button>
  </div>

  <div id="content" onscroll="stickHeader()"></div>
  <footer><span id="stat"></span></footer>
</div>

<div id="overlay">
  <div id="modal">
    <div class="mhead" id="mtitle">Teil</div>
    <div class="mbody">
      <div class="row3">
        <div class="field"><label>Position</label><input type="text" id="f_position" /></div>
        <div class="field"><label>Empfohlene Menge</label><input type="number" id="f_menge" /></div>
        <div class="field"><label>Position/Typ</label><input type="text" id="f_posTyp" /></div>
      </div>
      <div class="row2">
        <div class="field"><label>Artikelnummer *</label><input type="text" id="f_artikelnummer" /></div>
        <div class="field"><label>Erweiterte Art.Nr</label><input type="text" id="f_erwArtNr" /></div>
      </div>
      <div class="field"><label>Artikelbezeichnung</label><input type="text" id="f_bezeichnung" /></div>
      <div class="field">
        <label>Platz / Einbauort (z. B. DC30.1; mehrere mit ; trennen)</label>
        <input type="text" id="f_platz" />
      </div>
      <div class="field">
        <label>Schlagworte (Komma-getrennt, f&uuml;r die Suche)</label>
        <input type="text" id="f_schlagworte" />
      </div>
      <div class="row3">
        <div class="field"><label>Bauteilgruppe</label><input type="text" id="f_bauteilgruppe" /></div>
        <div class="field"><label>Hersteller</label><input type="text" id="f_hersteller" /></div>
        <div class="field"><label>Zuordnung (Lieferant)</label><input type="text" id="f_zuordnung" /></div>
      </div>
      <div class="row3">
        <div class="field"><label>IstMenge (Bestand)</label><input type="number" id="f_istMenge" /></div>
        <div class="field"><label>MinMenge (Grenzwert)</label><input type="number" id="f_minMenge" /></div>
        <div class="field"><label>Bin (Lagerort)</label><input type="text" id="f_bin" /></div>
      </div>
      <div class="row2">
        <div class="field">
          <label>Nachfolger (Artikelnummer)</label>
          <input type="text" id="f_nachfolger" />
          <div class="hint">Artikel-Nr. des Nachfolge-Teils (wie in der Excel)</div>
        </div>
        <div class="field">
          <label>&nbsp;</label>
          <label style="display:inline"><input type="checkbox" id="f_bestellt" /> Bestellt</label>
          &nbsp;&nbsp;
          <label style="display:inline"><input type="checkbox" id="f_ausgeblendet" /> Ausgeblendet</label>
        </div>
      </div>
      <div class="field"><label>Bemerkung</label><textarea id="f_bemerkung" rows="2"></textarea></div>
    </div>
    <div class="mfoot">
      <button onclick="closeModal()">Abbrechen</button>
      <button class="primary" onclick="saveForm()">Speichern</button>
    </div>
  </div>
</div>

<!-- Protokoll -->
<div id="logOverlay" style="display:none;position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(20,30,45,.45);z-index:100;">
  <div style="background:#fff;width:1000px;max-width:96%;margin:24px auto;border-radius:8px;box-shadow:0 12px 40px rgba(0,0,0,.3);overflow:hidden;">
    <div class="mhead">Buchungsprotokoll (Audit-Trail)</div>
    <div style="padding:10px 18px;border-bottom:1px solid #e0e5ec;">
      <label>Filter:</label>
      <input type="text" id="logFilter" placeholder="Artikel, Benutzer, Aktion, Datum ..." onkeyup="refreshLog()" style="min-width:280px" />
      <button onclick="refreshLog()">Aktualisieren</button>
      <span id="logCount" class="muted" style="margin-left:10px"></span>
    </div>
    <div style="padding:0 18px 8px;max-height:70vh;overflow:auto;">
      <div id="logBody"></div>
    </div>
    <div class="mfoot"><button class="primary" onclick="closeLog()">Schlie&szlig;en</button></div>
  </div>
</div>
</body>
</html>
